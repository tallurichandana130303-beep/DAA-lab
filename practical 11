
# Implementation of Floyd-Warshall Algorithm

INF = float('inf')

def floyd_warshall(graph):
    n = len(graph)
    dist = [row[:] for row in graph]

    for k in range(n):
        for i in range(n):
            for j in range(n):
                dist[i][j] = min(
                    dist[i][j],
                    dist[i][k] + dist[k][j]
                )

    print("Shortest distance matrix:")
    for row in dist:
        print(" ".join(
            "INF" if x == INF else str(x) for x in row
        ))

# 0 means distance from a vertex to itself.
# INF means there is no direct edge.
graph = [
    [0,   5,   INF, 10],
    [INF, 0,   3,   INF],
    [INF, INF, 0,   1],
    [INF, INF, INF, 0]
]

floyd_warshall(graph)
